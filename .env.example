# ──────────────────────────────────────────────
# NexusAgri Backend — Environment Variables
# Salin file ini menjadi .env dan isi nilainya
# JANGAN commit file .env ke GitHub!
# ──────────────────────────────────────────────

# OpenRouter AI
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MONTHLY_BUDGET=50

# Midtrans Payment
MIDTRANS_SERVER_KEY=your_midtrans_server_key_here
MIDTRANS_ENV=sandbox
# Ganti ke 'production' saat live

# App URL (untuk HTTP-Referer di OpenRouter)
APP_URL=https://nexusagri.id

# Firebase (hanya jika pakai Admin SDK di backend)
# FIREBASE_PROJECT_ID=nexusagri-f7bd9
# FIREBASE_CLIENT_EMAIL=your_service_account_email
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
